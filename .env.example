# Copia este fichero a .env y rellénalo. Nunca subas .env al repo.

# Clave de la API de Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Token del bot (lo da @BotFather al crearlo)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID numérico de tu chat con el bot. El bot ignora cualquier otro chat.
TELEGRAM_CHAT_ID=123456789

# Gmail que envía el informe y su contraseña de aplicación
EMAIL_USER=tucuenta@gmail.com
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Destinatarios separados por comas
EMAIL_TO=tucuenta@gmail.com,amigo@gmail.com

# true: guarda el estado del arte en un vault de Obsidian (vault/). false: solo informe semanal.
OBSIDIAN_MEMORY=false